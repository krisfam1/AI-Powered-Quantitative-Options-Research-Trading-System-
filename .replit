modules = ["python-3.11", "nodejs-22"]
run = "python main.py"

[workflows]
runButton = "Run Python script"

[[workflows.workflow]]
name = "Run Python script"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[agent]
stack = "PYTHON"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[userenv.production]
TRADING_LOOP = "1"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
run = ["python", "main.py"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8099
externalPort = 8099
