modules = ["python-3.11"]
run = "python main.py"

[workflows]
runButton = "Run Python script"

[[workflows.workflow]]
name = "Run Python script"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[agent]
stack = "PYTHON"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[nix]
channel = "stable-25_05"
